# terminfo entries for chezterm.
#
# Compile with:  tic -x -o ~/.terminfo terminfo/chezterm.terminfo
# (`make install` does this into $(PREFIX)/share/terminfo.)
#
# chezterm         256 colors; 24-bit color advertised with Tc / COLORTERM
# chezterm-direct  direct color (ncurses 6.1+ RGB): setaf/setab take 24-bit values
#
# The entry is self-contained rather than `use=xterm-256color`, so it
# only lists what chezterm implements and does not change with the local
# ncurses version.  tests/terminfo.ss feeds every capability through the
# terminal emulator and checks its effect.

chezterm+base|chezterm common capabilities,
	am, bce, ccc, km, mir, msgr, npc, xenl, hs,
	AX, XF, XT, Tc,
	cols#80, it#8, lines#24,
# cursor movement and scrolling
	cr=\r, cub=\E[%p1%dD, cub1=^H, cud=\E[%p1%dB, cud1=\n,
	cuf=\E[%p1%dC, cuf1=\E[C, cup=\E[%i%p1%d;%p2%dH,
	cuu=\E[%p1%dA, cuu1=\E[A, home=\E[H, hpa=\E[%i%p1%dG,
	vpa=\E[%i%p1%dd, ind=\n, indn=\E[%p1%dS, ri=\EM,
	rin=\E[%p1%dT, nel=\EE, csr=\E[%i%p1%d;%p2%dr,
	sc=\E7, rc=\E8, ht=^I, cbt=\E[Z, hts=\EH, tbc=\E[3g,
# editing
	clear=\E[H\E[2J, ed=\E[J, el=\E[K, el1=\E[1K, E3=\E[3J,
	dch=\E[%p1%dP, dch1=\E[P, dl=\E[%p1%dM, dl1=\E[M,
	ech=\E[%p1%dX, ich=\E[%p1%d@, il=\E[%p1%dL, il1=\E[L,
	smir=\E[4h, rmir=\E[4l, rep=%p1%c\E[%p2%{1}%-%db,
# attributes
	bold=\E[1m, dim=\E[2m, sitm=\E[3m, ritm=\E[23m,
	smul=\E[4m, rmul=\E[24m, Smulx=\E[4:%p1%dm,
	Setulc=\E[58:2::%p1%{65536}%/%d:%p1%{256}%/%{255}%&%d:%p1%{255}%&%dm,
	blink=\E[5m, rev=\E[7m, invis=\E[8m,
	smso=\E[7m, rmso=\E[27m, smxx=\E[9m, rmxx=\E[29m,
	sgr0=\E(B\E[m,
	sgr=%?%p9%t\E(0%e\E(B%;\E[0%?%p6%t;1%;%?%p5%t;2%;%?%p2%t;4%;%?%p1%p3%|%t;7%;%?%p4%t;5%;%?%p7%t;8%;m,
	smacs=\E(0, rmacs=\E(B,
	acsc=``aaffggiijjkkllmmnnooppqqrrssttuuvvwwxxyyzz{{||}}~~,
# colors
	op=\E[39;49m, oc=\E]104\007,
	initc=\E]4;%p1%d;rgb:%p2%{255}%*%{1000}%/%2.2X/%p3%{255}%*%{1000}%/%2.2X/%p4%{255}%*%{1000}%/%2.2X\E\\,
# modes and screens
	smam=\E[?7h, rmam=\E[?7l,
	smcup=\E[?1049h\E[22;0;0t, rmcup=\E[?1049l\E[23;0;0t,
	smkx=\E[?1h\E=, rmkx=\E[?1l\E>,
	civis=\E[?25l, cnorm=\E[?25h, cvvis=\E[?12;25h,
	Ss=\E[%p1%d q, Se=\E[0 q, Cs=\E]12;%p1%s\007, Cr=\E]112\007,
	flash=\E[?5h$<100/>\E[?5l, bel=^G,
	BE=\E[?2004h, BD=\E[?2004l, PS=\E[200~, PE=\E[201~,
	fe=\E[?1004h, fd=\E[?1004l, kxIN=\E[I, kxOUT=\E[O,
	Sync=\E[?2026%?%p1%{1}%-%tl%eh%;,
	Ms=\E]52;%p1%s;%p2%s\007,
	tsl=\E]2;, fsl=^G, dsl=\E]2;\007,
# reset and reports
	is2=\E[!p\E[?3;4l\E[4l\E>, rs1=\Ec\E]104\007,
	rs2=\E[!p\E[?3;4l\E[4l\E>,
	u6=\E[%i%d;%dR, u7=\E[6n, u8=\E[?%[;0123456789]c, u9=\E[c,
	RV=\E[>c, rv=\E\\[>1;[0-9]+;0c,
	XR=\E[>0q, xr=\EP>\\|chezterm [0-9.]+\E\\\\,
# mouse (SGR encoding)
	kmous=\E[<, XM=\E[?1006;1000%?%p1%{1}%=%th%el%;,
	xm=\E[<%i%p3%d;%p1%d;%p2%d;%?%p4%tM%em%;,
# keys
	kbs=^?, kcbt=\E[Z, kent=\EOM,
	kcuu1=\EOA, kcud1=\EOB, kcuf1=\EOC, kcub1=\EOD,
	khome=\EOH, kend=\EOF, kbeg=\EOE,
	kich1=\E[2~, kdch1=\E[3~, kpp=\E[5~, knp=\E[6~,
	ka1=\EOw, ka3=\EOy, kb2=\EOu, kc1=\EOq, kc3=\EOs,
	ka2=\EOx, kb1=\EOt, kb3=\EOv, kc2=\EOr, kp5=\EOE,
	kpADD=\EOk, kpCMA=\EOl, kpDIV=\EOo, kpDOT=\EOn, kpMUL=\EOj,
	kpSUB=\EOm, kpZRO=\EOp,
	kf1=\EOP, kf2=\EOQ, kf3=\EOR, kf4=\EOS, kf5=\E[15~,
	kf6=\E[17~, kf7=\E[18~, kf8=\E[19~, kf9=\E[20~,
	kf10=\E[21~, kf11=\E[23~, kf12=\E[24~,
	kf13=\E[1;2P, kf14=\E[1;2Q, kf15=\E[1;2R, kf16=\E[1;2S,
	kf17=\E[15;2~, kf18=\E[17;2~, kf19=\E[18;2~, kf20=\E[19;2~,
	kf21=\E[20;2~, kf22=\E[21;2~, kf23=\E[23;2~, kf24=\E[24;2~,
	kf25=\E[1;5P, kf26=\E[1;5Q, kf27=\E[1;5R, kf28=\E[1;5S,
	kf29=\E[15;5~, kf30=\E[17;5~, kf31=\E[18;5~, kf32=\E[19;5~,
	kf33=\E[20;5~, kf34=\E[21;5~, kf35=\E[23;5~, kf36=\E[24;5~,
	kf37=\E[1;6P, kf38=\E[1;6Q, kf39=\E[1;6R, kf40=\E[1;6S,
	kf41=\E[15;6~, kf42=\E[17;6~, kf43=\E[18;6~, kf44=\E[19;6~,
	kf45=\E[20;6~, kf46=\E[21;6~, kf47=\E[23;6~, kf48=\E[24;6~,
	kf49=\E[1;3P, kf50=\E[1;3Q, kf51=\E[1;3R, kf52=\E[1;3S,
	kf53=\E[15;3~, kf54=\E[17;3~, kf55=\E[18;3~, kf56=\E[19;3~,
	kf57=\E[20;3~, kf58=\E[21;3~, kf59=\E[23;3~, kf60=\E[24;3~,
	kf61=\E[1;4P, kf62=\E[1;4Q, kf63=\E[1;4R,
	kind=\E[1;2B, kri=\E[1;2A,
	kUP=\E[1;2A, kDN=\E[1;2B, kRIT=\E[1;2C, kLFT=\E[1;2D,
	kHOM=\E[1;2H, kEND=\E[1;2F, kIC=\E[2;2~, kDC=\E[3;2~,
	kPRV=\E[5;2~, kNXT=\E[6;2~,
	kUP3=\E[1;3A, kDN3=\E[1;3B, kRIT3=\E[1;3C, kLFT3=\E[1;3D,
	kHOM3=\E[1;3H, kEND3=\E[1;3F, kIC3=\E[2;3~, kDC3=\E[3;3~,
	kPRV3=\E[5;3~, kNXT3=\E[6;3~,
	kUP4=\E[1;4A, kDN4=\E[1;4B, kRIT4=\E[1;4C, kLFT4=\E[1;4D,
	kHOM4=\E[1;4H, kEND4=\E[1;4F, kIC4=\E[2;4~, kDC4=\E[3;4~,
	kPRV4=\E[5;4~, kNXT4=\E[6;4~,
	kUP5=\E[1;5A, kDN5=\E[1;5B, kRIT5=\E[1;5C, kLFT5=\E[1;5D,
	kHOM5=\E[1;5H, kEND5=\E[1;5F, kIC5=\E[2;5~, kDC5=\E[3;5~,
	kPRV5=\E[5;5~, kNXT5=\E[6;5~,
	kUP6=\E[1;6A, kDN6=\E[1;6B, kRIT6=\E[1;6C, kLFT6=\E[1;6D,
	kHOM6=\E[1;6H, kEND6=\E[1;6F, kIC6=\E[2;6~, kDC6=\E[3;6~,
	kPRV6=\E[5;6~, kNXT6=\E[6;6~,
	kUP7=\E[1;7A, kDN7=\E[1;7B, kRIT7=\E[1;7C, kLFT7=\E[1;7D,
	kHOM7=\E[1;7H, kEND7=\E[1;7F, kIC7=\E[2;7~, kDC7=\E[3;7~,
	kPRV7=\E[5;7~, kNXT7=\E[6;7~,

chezterm|chezterm terminal emulator (256 colors),
	colors#0x100, pairs#0x10000,
	setaf=\E[%?%p1%{8}%<%t3%p1%d%e%p1%{16}%<%t9%p1%{8}%-%d%e38;5;%p1%d%;m,
	setab=\E[%?%p1%{8}%<%t4%p1%d%e%p1%{16}%<%t10%p1%{8}%-%d%e48;5;%p1%d%;m,
	use=chezterm+base,

chezterm-direct|chezterm terminal emulator (direct color),
	RGB,
	colors#0x1000000, pairs#0x10000,
	setaf=\E[%?%p1%{8}%<%t3%p1%d%e38:2::%p1%{65536}%/%d:%p1%{256}%/%{255}%&%d:%p1%{255}%&%d%;m,
	setab=\E[%?%p1%{8}%<%t4%p1%d%e48:2::%p1%{65536}%/%d:%p1%{256}%/%{255}%&%d:%p1%{255}%&%d%;m,
	initc@, oc@, ccc@,
	use=chezterm+base,
