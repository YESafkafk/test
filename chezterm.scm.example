;;; chezterm configuration -- copy to ~/.config/chezterm/chezterm.scm
;;;
;;; Every form is (option value ...).  Options not given keep their
;;; defaults (shown here).  Any option can also be set on the command line
;;; with -o, e.g.  chezterm -o font-size=13 -o 'padding=(8 8)'

;;; Font ---------------------------------------------------------------------
(font-family "monospace")        ; any fontconfig family name
(font-size 11)                   ; points
(font-bold-family #f)            ; #f: bold variant of font-family
(font-italic-family #f)
(dpi 96)                         ; used to convert points to pixels

;;; Window -------------------------------------------------------------------
(columns 80)                     ; initial size in cells
(lines 24)
(padding 2 2)                    ; horizontal, vertical (logical pixels)
(opacity 1.0)                    ; background opacity, 0.0 - 1.0
(title "chezterm")
(app-id "chezterm")
(dynamic-title #t)               ; let programs set the title (OSC 0/2)
(decorations #t)                 ; ask for server-side decorations

;;; Terminal -----------------------------------------------------------------
(scrollback 10000)               ; lines of history
(shell #f)                       ; #f: $SHELL; or e.g. (shell "/bin/zsh" "-l")
(working-directory #f)
(term #f)                        ; value of $TERM; #f: "chezterm" when its
                                 ; terminfo entry is installed, otherwise
                                 ; "xterm-256color".  Use "chezterm-direct" for
                                 ; direct-color setaf/setab, or "xterm-256color"
                                 ; if you ssh to hosts without the entry.
(env)                            ; extra variables: (env ("KEY" . "value") ...)
(kitty-keyboard #t)              ; the kitty keyboard protocol: programs can ask
                                 ; for unambiguous keys, releases and more
                                 ; (CSI > flags u).  #f: its control sequences
                                 ; are ignored, CSI ? u gets no reply, and keys
                                 ; are always sent the legacy (xterm) way.
(kitty-keyboard-legacy-csi-u #f) ; #t: keys the legacy encoding sends nothing
                                 ; for (media keys, Menu, Print, Pause,
                                 ; Scroll Lock, F21-F35) are sent as CSI u even
                                 ; without kitty keyboard flags, as kitty does.
                                 ; All other keys stay as they are.

;;; Cursor -------------------------------------------------------------------
(cursor-style block)             ; block | underline | beam
(cursor-blink #f)
(cursor-blink-interval 750)      ; milliseconds
(cursor-unfocused-hollow #t)

;;; Mouse & selection --------------------------------------------------------
(scroll-multiplier 3)            ; lines per wheel step
(alternate-scroll #t)            ; wheel sends arrow keys in full-screen apps
(copy-on-select #t)              ; selections go to the primary selection
(clipboard-read deny)            ; allow: programs may read the clipboard and
                                 ; primary selection with OSC 52 ; c|p ; ?
                                 ; deny: they get an empty reply
(word-separators ",│`|:\"' ()[]{}<>\t")
(mouse-hide-when-typing #f)      ; hide the pointer while typing, until it
                                 ; moves, a button is pressed or the wheel turns

;;; Links & keyboard hints ---------------------------------------------------
(open-command "xdg-open")        ; opens links and URLs (Ctrl+click, hint-open);
                                 ; the URI is appended as the last argument,
                                 ; e.g. (open-command "firefox" "--new-window")
;;; hint-open, hint-copy, hint-paste and hint-select (see the key bindings
;;; below) label every OSC 8 link and URL on screen; typing a label runs
;;; the action on it, Backspace removes the last key typed, Escape leaves.
(hint-alphabet "jfkdls;ahgurieowpq") ; label characters: the first half
                                 ; (rounded down, of all but one) ends a
                                 ; label, the rest begins longer ones

;;; Bell ---------------------------------------------------------------------
(bell-duration 0)                ; visual bell: on BEL the window is tinted in
                                 ; the bell color (see colors), fading out over
                                 ; this many milliseconds, as in Alacritty;
                                 ; 0: no visual bell
(bell-command #f)                ; program run on BEL, e.g.
                                 ; (bell-command "paplay" "/usr/share/sounds/freedesktop/stereo/bell.oga")
(bell-urgent #f)                 ; #t: BEL marks the window as urgent while it
                                 ; is not focused (xdg-activation-v1), as foot's
                                 ; bell.urgent; programs can turn that off
                                 ; with CSI ? 1042 l

;;; Colors -------------------------------------------------------------------
(bold-is-bright #f)              ; draw bold text in bright colors
(colors
 (foreground "#d8d8d8")
 (background "#181818")
 (cursor "#d8d8d8")
 (selection-foreground #f)       ; #f: keep the text color
 (selection-background "#4f4f4f")
 (hint-foreground "#181818")     ; hint labels: keys still to type
 (hint-background "#f4bf75")
 (hint-typed-foreground "#181818") ; and keys typed
 (hint-typed-background "#ac4242")
 (bell "#ffffff")                ; the visual bell's flash
 (normal "#181818" "#ac4242" "#90a959" "#f4bf75"
         "#6a9fb5" "#aa759f" "#75b5aa" "#d8d8d8")
 (bright "#6b6b6b" "#c55555" "#aac474" "#feca88"
         "#82b8c8" "#c28cb8" "#93d3c3" "#f8f8f8"))

;;; Key bindings -------------------------------------------------------------
;;; (bind "modifiers+key" action) where key is an xkb keysym name and the
;;; modifiers are ctrl, shift, alt and super.  Actions:
;;;   copy paste paste-primary increase-font-size decrease-font-size
;;;   reset-font-size scroll-page-up scroll-page-down scroll-half-page-up
;;;   scroll-half-page-down scroll-line-up scroll-line-down scroll-to-top
;;;   scroll-to-bottom scroll-to-previous-prompt scroll-to-next-prompt
;;;   (prompts the shell marks with OSC 133;A) select-last-command-output
;;;   copy-last-command-output (the last command's output, from its OSC
;;;   133;C to the next A, C or D; copied to the clipboard)
;;;   select-first-command-output-on-screen
;;;   copy-first-command-output-on-screen (the same for the first command
;;;   whose output starts in the view) clear-history clear-selection
;;;   reset spawn-new-instance
;;;   toggle-fullscreen search-forward search-backward
;;;   hint-open (open a link or URL with the open-command; http, https,
;;;   ftp, file and mailto only), hint-copy (copy its URI to the
;;;   clipboard), hint-paste (paste its URI into the program, with
;;;   bracketed paste if the program asked for it), hint-select (select
;;;   its text)  quit none
;;; or a string, which is sent to the program as if typed.
;;; Your bindings take precedence over the defaults:
;;;   ctrl+shift+c copy            ctrl+shift+v paste
;;;   shift+insert paste-primary   ctrl+insert copy
;;;   ctrl+equal / ctrl+plus       increase-font-size
;;;   ctrl+minus decrease-font-size   ctrl+0 reset-font-size
;;;   shift+page_up / page_down    scroll a page
;;;   shift+home / shift+end       scroll to top / bottom
;;;   ctrl+shift+up / down         scroll a line
;;;   ctrl+shift+z / ctrl+shift+x  scroll to the previous / next prompt
;;;   ctrl+shift+k clear-history   ctrl+shift+n spawn-new-instance
;;;   ctrl+shift+f search-forward  ctrl+shift+b search-backward
;;;   ctrl+shift+o hint-open       ctrl+shift+y hint-copy
;;;   f11 toggle-fullscreen
;;
;; (bind "ctrl+shift+t" spawn-new-instance)
;; (bind "ctrl+shift+l" "ls -l\r")
;; (bind "ctrl+shift+s" hint-select)
;; (bind "ctrl+shift+p" hint-paste)
;; (bind "ctrl+shift+g" copy-last-command-output)
